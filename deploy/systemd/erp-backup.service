[Unit]
Description=Encrypted ERP database and private-media backup
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=erp-backup
Group=erpmedia
SupplementaryGroups=erpmedia
WorkingDirectory=/srv/erp/current
EnvironmentFile=/etc/erp/backup.env
Environment=DJANGO_ENV=production
ExecStart=/srv/erp/current/scripts/backup.sh
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateDevices=yes
ReadOnlyPaths=/srv/erp/private_media
ReadWritePaths=/srv/erp/backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
